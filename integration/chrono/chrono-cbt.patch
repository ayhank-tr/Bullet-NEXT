+// Bullet NEXT (F1, C1.6b): one-shot contact reduction for mesh pairs. Points from all triangles
+// are gathered first, then at most four are kept: the deepest, the farthest from it, the one
+// giving the largest triangle, and the one adding the most area. Inserting them one by one (the
+// upstream path) lets later triangles push out good points and leaves a sliding box with too
+// little support, so it sinks for a frame.
+bool gBnMeshContactReduction = false;
+
+static cbtScalar bnTriArea2(const cbtVector3& a, const cbtVector3& b, const cbtVector3& c)
+{
+	return (b - a).cross(c - a).length2();
+}
+
+static void bnInsertReduced(cbtAlignedObjectArray<cbtManifoldPoint>& pts, cbtPersistentManifold* manifold)
+{
+	const int n = pts.size();
+	if (n == 0)
+		return;
+	int chosen[4] = {-1, -1, -1, -1};
+	int count = 0;
+	if (n <= 4)
+	{
+		for (int i = 0; i < n; ++i)
+			chosen[count++] = i;
+	}
+	else
+	{
+		int a = 0;
+		for (int i = 1; i < n; ++i)
+			if (pts[i].m_distance1 < pts[a].m_distance1)
+				a = i;
+		chosen[count++] = a;
+		const cbtVector3 pa = pts[a].m_positionWorldOnB;
+		int b = -1;
+		cbtScalar best = cbtScalar(1e-6);
+		for (int i = 0; i < n; ++i)
+		{
+			const cbtScalar d = (pts[i].m_positionWorldOnB - pa).length2();
+			if (d > best) { best = d; b = i; }
+		}
+		if (b >= 0)
+		{
+			chosen[count++] = b;
+			const cbtVector3 pb = pts[b].m_positionWorldOnB;
+			int c = -1;
+			best = cbtScalar(1e-10);
+			for (int i = 0; i < n; ++i)
+			{
+				const cbtScalar ar = bnTriArea2(pa, pb, pts[i].m_positionWorldOnB);
+				if (ar > best) { best = ar; c = i; }
+			}
+			if (c >= 0)
+			{
+				chosen[count++] = c;
+				const cbtVector3 pc = pts[c].m_positionWorldOnB;
+				const cbtScalar base = cbtSqrt(bnTriArea2(pa, pb, pc));
+				int d = -1;
+				best = base * cbtScalar(1.0001);
+				for (int i = 0; i < n; ++i)
+				{
+					const cbtVector3& p = pts[i].m_positionWorldOnB;
+					const cbtScalar s = cbtSqrt(bnTriArea2(pa, pb, p)) + cbtSqrt(bnTriArea2(pb, pc, p)) + cbtSqrt(bnTriArea2(pc, pa, p));
+					if (s > best) { best = s; d = i; }
+				}
+				if (d >= 0)
+					chosen[count++] = d;
+			}
+		}
+	}
+	for (int k = 0; k < count; ++k)
+	{
+		cbtManifoldPoint& pt = pts[chosen[k]];
+		const int idx = manifold->getCacheEntry(pt);
+		if (idx >= 0)
+			manifold->replaceContactPoint(pt, idx);
+		else
+			manifold->addManifoldPoint(pt);
+	}
+}
