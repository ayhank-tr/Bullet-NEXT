+/*
+Bullet NEXT collision features for Chrono's Bullet copy (F1, T1.7).
+Copyright (c) 2026 BGE NEXT contributors. Same zlib terms as Bullet.
+
+The collision-only part of Bullet NEXT's cbtNextFeatures: hull clipping, active edges with the
+flat-region rule and exact sphere-on-face contacts, and SAT for triangles plus the one-shot mesh
+contact reduction. Chrono's own dynamics and CCD are untouched.
+*/
+#define BT_NEXT_HEIGHTFIELD_EDGES 0  // Chrono's heightfield has no internal-edge data
+#include "cbtNextCollision.h"
+
+#include "BulletCollision/CollisionDispatch/cbtCollisionWorld.h"
+#include "BulletCollision/CollisionDispatch/cbtInternalEdgeUtility.h"
+#include "BulletCollision/CollisionDispatch/cbtCollisionObjectWrapper.h"
+#include "BulletCollision/CollisionDispatch/cbtManifoldResult.h"
+#include "BulletCollision/CollisionShapes/cbtBvhTriangleMeshShape.h"
+#include "BulletCollision/CollisionShapes/cbtScaledBvhTriangleMeshShape.h"
+#include "BulletCollision/CollisionShapes/cbtHeightfieldTerrainShape.h"
+#include "BulletCollision/CollisionShapes/cbtTriangleInfoMap.h"
+#include "BulletCollision/CollisionShapes/cbtPolyhedralConvexShape.h"
+#include "BulletCollision/CollisionShapes/cbtCompoundShape.h"
+#include "BulletCollision/BroadphaseCollision/cbtBroadphaseProxy.h"
+#include "BulletCollision/BroadphaseCollision/cbtQuantizedBvh.h"
+#include "BulletCollision/CollisionShapes/cbtTriangleShape.h"
+#include "BulletCollision/CollisionShapes/cbtSphereShape.h"
+#include "BulletCollision/CollisionDispatch/cbtConvexConcaveCollisionAlgorithm.h"
+
+int cbtNextEnableHullClipping(cbtCollisionShape* shape)
+{
+	if (!shape)
+		return 0;
+	if (shape->isCompound())
+	{
+		cbtCompoundShape* c = static_cast<cbtCompoundShape*>(shape);
+		int n = 0;
+		for (int i = 0; i < c->getNumChildShapes(); ++i)
+			n += cbtNextEnableHullClipping(c->getChildShape(i));
+		return n;
+	}
+	if (shape->isPolyhedral())
+	{
+		cbtPolyhedralConvexShape* p = static_cast<cbtPolyhedralConvexShape*>(shape);
+		if (!p->getConvexPolyhedron())
+			p->initializePolyhedralFeatures();
+		return 1;
+	}
+	return 0;
+}
+
+// --- Active edges -------------------------------------------------------------------------
+// Heightfields keep internal-edge data from Bullet 2.85 on; copies built on an older Bullet
+// (Chrono's) set this to 0.
+#ifndef BT_NEXT_HEIGHTFIELD_EDGES
+#define BT_NEXT_HEIGHTFIELD_EDGES 1
+#endif
+
+bool gBnFlatRegionRule = true;
+static ContactAddedCallback s_previousContactAdded = 0;
+static bool s_activeEdgesInstalled = false;
+
+static bool isTriangle(const cbtCollisionObjectWrapper* w)
+{
+	return w && w->getCollisionShape()->getShapeType() == TRIANGLE_SHAPE_PROXYTYPE;
+}
+
+// The triangle's parent wrapper holds the mesh shape, also when the mesh is a compound child.
+static cbtTriangleInfoMap* meshInfoMap(const cbtCollisionObjectWrapper* triWrap)
+{
+	const cbtCollisionShape* shape = triWrap->m_parent ? triWrap->m_parent->getCollisionShape() : triWrap->getCollisionObject()->getCollisionShape();
+	switch (shape->getShapeType())
+	{
+		case SCALED_TRIANGLE_MESH_SHAPE_PROXYTYPE:
+			return const_cast<cbtTriangleInfoMap*>(static_cast<const cbtScaledBvhTriangleMeshShape*>(shape)->getChildShape()->getTriangleInfoMap());
+		case TRIANGLE_MESH_SHAPE_PROXYTYPE:
+			return const_cast<cbtTriangleInfoMap*>(static_cast<const cbtBvhTriangleMeshShape*>(shape)->getTriangleInfoMap());
+#if BT_NEXT_HEIGHTFIELD_EDGES
+		case TERRAIN_SHAPE_PROXYTYPE:
+			return const_cast<cbtTriangleInfoMap*>(static_cast<const cbtHeightfieldTerrainShape*>(shape)->getTriangleInfoMap());
+#endif
+		default:
+			return 0;
+	}
+}
+
+// Jolt-style rule for flat regions: when every edge of the touched triangle joins a coplanar
+// neighbour (within 5 degrees), no edge or vertex can be a real feature, so the contact normal
+// must be the face normal. Mesh is body B here.
+static void flatRegionNormal(cbtManifoldPoint& cp, const cbtCollisionObjectWrapper* triWrap, int partId, int index)
+{
+	cbtTriangleInfoMap* map = meshInfoMap(triWrap);
+	if (!map)
+		return;
+	const int hash = (partId << (31 - MAX_NUM_PARTS_IN_BITS)) | index;
+	const cbtTriangleInfo* info = map->find(hash);
+	if (!info)
+		return;
+	const cbtScalar flat = cbtScalar(0.0873);  // 5 degrees
+	if (cbtFabs(info->m_edgeV0V1Angle) > flat || cbtFabs(info->m_edgeV1V2Angle) > flat || cbtFabs(info->m_edgeV2V0Angle) > flat)
+		return;
+	const cbtTriangleShape* tri = static_cast<const cbtTriangleShape*>(triWrap->getCollisionShape());
+	cbtVector3 n;
+	tri->calcNormal(n);
+	n = triWrap->getWorldTransform().getBasis() * n;
+	if (n.dot(cp.m_normalWorldOnB) < 0)
+		n = -n;
+	cp.m_normalWorldOnB = n;
+	cp.m_positionWorldOnB = cp.m_positionWorldOnA - n * cp.m_distance1;
+	cp.m_localPointB = triWrap->getWorldTransform().invXform(cp.m_positionWorldOnB);
+}
+
+// Mesh-as-B convention. After the edge correction swaps the normal for the face normal, the
+// point on A is still where the edge test put it. For a sphere that point is off-centre, so a
+// rolling sphere gets a false approach speed (spin x lever arm) and pops off the mesh. Rebuild
+// the sphere contact exactly from the face plane instead.
+static void sphereOnFace(cbtManifoldPoint& cp, const cbtCollisionObjectWrapper* triWrap, const cbtCollisionObjectWrapper* otherWrap)
+{
+	if (otherWrap->getCollisionShape()->getShapeType() != SPHERE_SHAPE_PROXYTYPE)
+		return;
+	const cbtTriangleShape* tri = static_cast<const cbtTriangleShape*>(triWrap->getCollisionShape());
+	cbtVector3 v0;
+	tri->getVertex(0, v0);
+	v0 = triWrap->getWorldTransform() * v0;
+	const cbtVector3& n = cp.m_normalWorldOnB;
+	const cbtVector3 c = otherWrap->getWorldTransform().getOrigin();
+	const cbtScalar r = static_cast<const cbtSphereShape*>(otherWrap->getCollisionShape())->getRadius();
+	const cbtScalar h = (c - v0).dot(n);
+	cp.m_distance1 = h - r;
+	cp.m_positionWorldOnB = c - n * h;
+	cp.m_positionWorldOnA = c - n * r;
+	cp.m_localPointB = triWrap->getWorldTransform().invXform(cp.m_positionWorldOnB);
+	cp.m_localPointA = otherWrap->getWorldTransform().invXform(cp.m_positionWorldOnA);
+}
+
+static void correctMeshContact(cbtManifoldPoint& cp, const cbtCollisionObjectWrapper* triWrap,
+							   const cbtCollisionObjectWrapper* otherWrap, int partId, int index)
+{
+	const cbtVector3 before = cp.m_normalWorldOnB;
+	cbtAdjustInternalEdgeContacts(cp, triWrap, otherWrap, partId, index);
+	if (gBnFlatRegionRule)
+		flatRegionNormal(cp, triWrap, partId, index);
+	if (before.dot(cp.m_normalWorldOnB) < cbtScalar(0.99999))
+		sphereOnFace(cp, triWrap, otherWrap);
+}
+
+static bool bnContactAdded(cbtManifoldPoint& cp, const cbtCollisionObjectWrapper* w0, int partId0, int index0,
+						   const cbtCollisionObjectWrapper* w1, int partId1, int index1)
+{
+	if (isTriangle(w1))
+	{
+		// Mesh is body B: the utility's own convention.
+		correctMeshContact(cp, w1, w0, partId1, index1);
+	}
+	else if (isTriangle(w0))
+	{
+		// Mesh is body A: flip the point into the mesh-as-B convention, correct, flip back.
+		cbtSwap(cp.m_positionWorldOnA, cp.m_positionWorldOnB);
+		cbtSwap(cp.m_localPointA, cp.m_localPointB);
+		cp.m_normalWorldOnB = -cp.m_normalWorldOnB;
+		correctMeshContact(cp, w0, w1, partId0, index0);
+		cbtSwap(cp.m_positionWorldOnA, cp.m_positionWorldOnB);
+		cbtSwap(cp.m_localPointA, cp.m_localPointB);
+		cp.m_normalWorldOnB = -cp.m_normalWorldOnB;
+	}
+	if (s_previousContactAdded)
+		return s_previousContactAdded(cp, w0, partId0, index0, w1, partId1, index1);
+	return false;
+}
+
+// Bake internal-edge data for every mesh and heightfield in the shape (compounds recursively).
+static int bakeEdgeInfo(cbtCollisionShape* shape)
+{
+	if (shape->isCompound())
+	{
+		cbtCompoundShape* c = static_cast<cbtCompoundShape*>(shape);
+		int n = 0;
+		for (int i = 0; i < c->getNumChildShapes(); ++i)
+			n += bakeEdgeInfo(c->getChildShape(i));
+		return n;
+	}
+	cbtBvhTriangleMeshShape* bvh = 0;
+	if (shape->getShapeType() == SCALED_TRIANGLE_MESH_SHAPE_PROXYTYPE)
+		bvh = static_cast<cbtScaledBvhTriangleMeshShape*>(shape)->getChildShape();
+	else if (shape->getShapeType() == TRIANGLE_MESH_SHAPE_PROXYTYPE)
+		bvh = static_cast<cbtBvhTriangleMeshShape*>(shape);
+	if (bvh)
+	{
+		if (!bvh->getTriangleInfoMap())
+		{
+			cbtTriangleInfoMap* map = new cbtTriangleInfoMap();  // owned by the shape's lifetime
+			cbtGenerateInternalEdgeInfo(bvh, map);
+		}
+		return 1;
+	}
+#if BT_NEXT_HEIGHTFIELD_EDGES
+	if (shape->getShapeType() == TERRAIN_SHAPE_PROXYTYPE)
+	{
+		cbtHeightfieldTerrainShape* hf = static_cast<cbtHeightfieldTerrainShape*>(shape);
+		if (!hf->getTriangleInfoMap())
+		{
+			cbtTriangleInfoMap* map = new cbtTriangleInfoMap();
+			cbtGenerateInternalEdgeInfo(hf, map);
+		}
+		return 1;
+	}
+#endif
+	return 0;
+}
+
+bool cbtNextEnableActiveEdges(cbtCollisionObject* obj)
+{
+	if (!obj || !obj->getCollisionShape())
+		return false;
+	if (bakeEdgeInfo(obj->getCollisionShape()) == 0)
+		return false;
+
+	obj->setCollisionFlags(obj->getCollisionFlags() | cbtCollisionObject::CF_CUSTOM_MATERIAL_CALLBACK);
+	if (!s_activeEdgesInstalled)
+	{
+		s_previousContactAdded = gContactAddedCallback;
+		gContactAddedCallback = bnContactAdded;
+		s_activeEdgesInstalled = true;
+	}
+	return true;
+}
+
+void cbtNextConfigureCollision(cbtCollisionWorld* world)
+{
+	world->getDispatchInfo().m_enableSatConvex = true;
+	gBnMeshContactReduction = true;
+}
