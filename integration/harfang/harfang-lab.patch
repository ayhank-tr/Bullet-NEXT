diff --git a/harfang/engine/scene_lab_physics.cpp b/harfang/engine/scene_lab_physics.cpp
new file mode 100644
index 0000000..9bc63b4
--- /dev/null
+++ b/harfang/engine/scene_lab_physics.cpp
@@ -0,0 +1,264 @@
+// Bullet NEXT Lab - the Lab physics module of HARFANG (FL, CL.2).
+#include "engine/scene_lab_physics.h"
+#include "engine/scene.h"
+#include "engine/vertex.h"
+
+#include "foundation/format.h"
+#include "foundation/log.h"
+
+#include "bnl_engine.h"
+#include "bnl_mesh.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+
+namespace hg {
+
+namespace {
+
+// Scene axes (Z up) <-> HARFANG axes (Y up): swap y and z. The swap is its own inverse.
+Vec3 ToHg(const bnl::Vec3 &v) { return {v.x, v.z, v.y}; }
+bnl::Vec3 ToLab(const Vec3 &v) { return bnl::Vec3(v.x, v.z, v.y); }
+
+Mat4 ToHg(const bnl::Xform &x) {
+	const float X = x.q.x, Y = x.q.y, Z = x.q.z, W = x.q.w;
+	const float r[3][3] = {{1 - 2 * (Y * Y + Z * Z), 2 * (X * Y - W * Z), 2 * (X * Z + W * Y)},
+		{2 * (X * Y + W * Z), 1 - 2 * (X * X + Z * Z), 2 * (Y * Z - W * X)},
+		{2 * (X * Z - W * Y), 2 * (Y * Z + W * X), 1 - 2 * (X * X + Y * Y)}};
+	const int s[3] = {0, 2, 1};
+	Mat4 m;
+	for (int i = 0; i < 3; ++i) {
+		for (int j = 0; j < 3; ++j)
+			m.m[i][j] = r[s[i]][s[j]];
+	}
+	const Vec3 t = ToHg(x.p);
+	m.m[0][3] = t.x;
+	m.m[1][3] = t.y;
+	m.m[2][3] = t.z;
+	return m;
+}
+
+bnl::Xform ToLab(const Mat4 &m) {
+	// Rotation part (assumed orthonormal) back to the scene axes, then to a quaternion.
+	const int s[3] = {0, 2, 1};
+	float r[3][3];
+	for (int i = 0; i < 3; ++i)
+		for (int j = 0; j < 3; ++j)
+			r[s[i]][s[j]] = m.m[i][j];
+	bnl::Xform x;
+	x.p = ToLab(Vec3(m.m[0][3], m.m[1][3], m.m[2][3]));
+	const float tr = r[0][0] + r[1][1] + r[2][2];
+	bnl::Quat &q = x.q;
+	if (tr > 0) {
+		const float k = 0.5f / std::sqrt(tr + 1);
+		q = bnl::Quat((r[2][1] - r[1][2]) * k, (r[0][2] - r[2][0]) * k, (r[1][0] - r[0][1]) * k, 0.25f / k);
+	} else if (r[0][0] > r[1][1] && r[0][0] > r[2][2]) {
+		const float k = 2 * std::sqrt(1 + r[0][0] - r[1][1] - r[2][2]);
+		q = bnl::Quat(0.25f * k, (r[0][1] + r[1][0]) / k, (r[0][2] + r[2][0]) / k, (r[2][1] - r[1][2]) / k);
+	} else if (r[1][1] > r[2][2]) {
+		const float k = 2 * std::sqrt(1 + r[1][1] - r[0][0] - r[2][2]);
+		q = bnl::Quat((r[0][1] + r[1][0]) / k, 0.25f * k, (r[1][2] + r[2][1]) / k, (r[0][2] - r[2][0]) / k);
+	} else {
+		const float k = 2 * std::sqrt(1 + r[2][2] - r[0][0] - r[1][1]);
+		q = bnl::Quat((r[0][2] + r[2][0]) / k, (r[1][2] + r[2][1]) / k, 0.25f * k, (r[1][0] - r[0][1]) / k);
+	}
+	return x;
+}
+
+std::string Hex(bnl::u64 h) {
+	char buf[24];
+	std::snprintf(buf, sizeof(buf), "%016llx", (unsigned long long)h);
+	return buf;
+}
+
+} // namespace
+
+SceneLabPhysics::SceneLabPhysics() = default;
+SceneLabPhysics::~SceneLabPhysics() = default;
+
+std::vector<std::string> SceneLabPhysics::GetEngineNames() { return bnl::engineNames(); }
+std::vector<std::string> SceneLabPhysics::GetSceneNames(const std::string &dir) { return bnl::listScenes(dir); }
+
+bool SceneLabPhysics::LoadRecording(const std::string &path, const std::string &recording) {
+	error.clear();
+	std::unique_ptr<bnl::SceneDesc> d(new bnl::SceneDesc);
+	if (!bnl::loadScene(path, *d, error))
+		return false;
+	std::unique_ptr<bnl::Engine> e(bnl::createEngine("replay"));
+	bnl::EngineOptions o;
+	o.recording = recording;
+	if (!e->build(*d, o, error))
+		return false;
+	desc = std::move(d);
+	engine = std::move(e);
+	return true;
+}
+
+bool SceneLabPhysics::LoadScene(const std::string &path, const std::string &engine_name, int threads) {
+	error.clear();
+	std::unique_ptr<bnl::SceneDesc> d(new bnl::SceneDesc);
+	if (!bnl::loadScene(path, *d, error))
+		return false;
+	std::unique_ptr<bnl::Engine> e(bnl::createEngine(engine_name));
+	if (!e) {
+		error = "engine '" + engine_name + "' is not part of this build";
+		return false;
+	}
+	bnl::EngineOptions o;
+	o.threads = threads;
+	if (!e->build(*d, o, error))
+		return false;
+	desc = std::move(d);
+	engine = std::move(e);
+	return true;
+}
+
+std::string SceneLabPhysics::GetEngineName() const { return engine ? engine->backend() : ""; }
+std::string SceneLabPhysics::GetSceneName() const { return desc ? desc->name : ""; }
+int SceneLabPhysics::GetFrameCount() const { return desc ? desc->frames : 0; }
+int SceneLabPhysics::GetFrame() const { return engine ? engine->frame() : 0; }
+float SceneLabPhysics::GetTimeStep() const { return desc ? 1.f / desc->settings.ticrate : 1.f / 60.f; }
+
+void SceneLabPhysics::Step() {
+	if (engine)
+		engine->advance();
+}
+
+double SceneLabPhysics::GetLastStepMs() const { return engine ? engine->lastStepMicros() / 1000.0 : 0.0; }
+std::string SceneLabPhysics::GetFrameHash() const { return Hex(engine ? engine->frameHash() : 0); }
+std::string SceneLabPhysics::GetFinalHash() const { return Hex(engine ? engine->finalHash() : 0); }
+
+int SceneLabPhysics::GetBodyCount() const { return engine ? engine->bodyCount() : 0; }
+LabBodyKind SceneLabPhysics::GetBodyKind(int i) const { return desc ? LabBodyKind(desc->bodies[i].kind) : LBK_Static; }
+std::string SceneLabPhysics::GetBodyName(int i) const { return desc ? desc->bodies[i].name : ""; }
+
+Mat4 SceneLabPhysics::GetBodyWorld(int i) const {
+	const bnl::BodyState s = engine->body(i);
+	bnl::Xform x;
+	x.p = s.p;
+	x.q = s.q;
+	return ToHg(x);
+}
+
+Vec3 SceneLabPhysics::GetBodyLinearVelocity(int i) const { return ToHg(engine->body(i).lin); }
+Vec3 SceneLabPhysics::GetBodyAngularVelocity(int i) const {
+	// An angular velocity is an axial vector: the axis swap (a mirror) also flips its sign.
+	const Vec3 w = ToHg(engine->body(i).ang);
+	return {-w.x, -w.y, -w.z};
+}
+
+Model SceneLabPhysics::CreateBodyModel(int i, const bgfx::VertexLayout &layout) const {
+	bnl::TriMesh mesh;
+	bnl::bodyMesh(desc->bodies[i], mesh);
+	ModelBuilder builder;
+	for (size_t t = 0; t + 2 < mesh.tris.size(); t += 3) {
+		const Vec3 a = ToHg(mesh.verts[mesh.tris[t]]), b = ToHg(mesh.verts[mesh.tris[t + 1]]), c = ToHg(mesh.verts[mesh.tris[t + 2]]);
+		const Vec3 n = Normalize(Cross(c - a, b - a)); // winding is mirrored by the axis swap
+		const auto ia = builder.AddVertex(MakeVertex(a, n)), ib = builder.AddVertex(MakeVertex(b, n)), ic = builder.AddVertex(MakeVertex(c, n));
+		builder.AddTriangle(ia, ic, ib);
+	}
+	builder.EndList(0);
+	return builder.MakeModel(layout);
+}
+
+void SceneLabPhysics::GetSoftBodyTriangles(int i, Vertices &vtx, const Color &color) const {
+	vtx.Clear();
+	if (!desc || desc->bodies[i].kind != bnl::kSoft)
+		return;
+	std::vector<bnl::Vec3> nodes;
+	engine->softNodes(i, nodes);
+	bnl::TriMesh mesh;
+	bnl::bodyMesh(desc->bodies[i], mesh);
+	size_t n = 0;
+	for (size_t t = 0; t + 2 < mesh.tris.size(); t += 3) {
+		const int ids[3] = {mesh.tris[t], mesh.tris[t + 2], mesh.tris[t + 1]};
+		if (ids[0] >= (int)nodes.size() || ids[1] >= (int)nodes.size() || ids[2] >= (int)nodes.size())
+			continue;
+		const Vec3 a = ToHg(nodes[ids[0]]), b = ToHg(nodes[ids[1]]), c = ToHg(nodes[ids[2]]);
+		const Vec3 nrm = Normalize(Cross(b - a, c - a));
+		const Vec3 p[3] = {a, b, c};
+		for (int k = 0; k < 3; ++k)
+			vtx.Begin(n++).SetPos(p[k]).SetNormal(nrm).SetColor0(color).End();
+	}
+}
+
+int SceneLabPhysics::GetVehicleCount() const { return engine ? engine->vehicleCount() : 0; }
+int SceneLabPhysics::GetWheelCount(int v) const { return engine ? engine->wheelCount(v) : 0; }
+Mat4 SceneLabPhysics::GetWheelWorld(int v, int w) const { return ToHg(engine->wheel(v, w)); }
+
+float SceneLabPhysics::GetWheelRadius(int v, int w) const {
+	int k = 0;
+	for (const auto &wd : desc->wheels)
+		if (wd.vehicle == v && k++ == w)
+			return wd.radius;
+	return 0.f;
+}
+
+int SceneLabPhysics::GetContactCount() const {
+	if (!engine)
+		return 0;
+	std::vector<bnl::Contact> c;
+	engine->contacts(c);
+	return int(c.size());
+}
+
+void SceneLabPhysics::GetContactLines(Vertices &vtx, float length, const Color &color) const {
+	vtx.Clear();
+	if (!engine)
+		return;
+	std::vector<bnl::Contact> c;
+	engine->contacts(c);
+	size_t n = 0;
+	for (const auto &k : c) {
+		const Vec3 p = ToHg(k.pb), q = p + ToHg(k.n) * length;
+		vtx.Begin(n++).SetPos(p).SetColor0(color).End();
+		vtx.Begin(n++).SetPos(q).SetColor0(color).End();
+	}
+}
+
+void SceneLabPhysics::UpdateScene(Scene &scene, const std::vector<Node> &nodes, time_ns dt) {
+	scene.StorePreviousWorldMatrices();
+	scene.ReadyWorldMatrices();
+	scene.UpdatePlayingAnims(dt);
+	Step();
+	SyncNodes(scene, nodes);
+	scene.ComputeWorldMatrices();
+	scene.FixupPreviousWorldMatrices();
+}
+
+void SceneLabPhysics::SyncNodes(Scene &scene, const std::vector<Node> &nodes) const {
+	if (!engine)
+		return;
+	const int count = std::min(int(nodes.size()), engine->bodyCount());
+	for (int i = 0; i < count; ++i)
+		if (nodes[i].IsValid())
+			scene.SetNodeWorldMatrix(nodes[i].ref, GetBodyWorld(i));
+}
+
+void SceneLabPhysics::SetLinearVelocity(int b, const Vec3 &v) { engine->setLinearVelocity(b, ToLab(v)); }
+void SceneLabPhysics::SetAngularVelocity(int b, const Vec3 &w) { engine->setAngularVelocity(b, ToLab(-w)); }
+void SceneLabPhysics::AddForce(int b, const Vec3 &f) { engine->applyForce(b, ToLab(f)); }
+void SceneLabPhysics::AddImpulse(int b, const Vec3 &j) { engine->applyImpulse(b, ToLab(j)); }
+void SceneLabPhysics::AddImpulseAt(int b, const Vec3 &j, const Vec3 &p) { engine->applyImpulseAt(b, ToLab(j), ToLab(p)); }
+void SceneLabPhysics::AddTorque(int b, const Vec3 &t) { engine->applyTorque(b, ToLab(-t)); }
+void SceneLabPhysics::Teleport(int b, const Mat4 &world) { engine->setTransform(b, ToLab(world)); }
+void SceneLabPhysics::Wake(int b) { engine->wake(b); }
+
+bool SceneLabPhysics::RaycastFirstHit(const Vec3 &p0, const Vec3 &p1, int &body, Vec3 &P, Vec3 &N) const {
+	bnl::RayHit h;
+	if (!engine || !engine->raycast(ToLab(p0), ToLab(p1), h)) {
+		body = -1;
+		return false;
+	}
+	body = h.body;
+	P = ToHg(h.p);
+	N = ToHg(h.n);
+	return true;
+}
+
+void SceneLabPhysics::VehicleControl(int v, int w, float e, float b, float s) { engine->vehicleControl(v, w, e, b, s); }
+void SceneLabPhysics::CharacterWalk(int b, const Vec3 &step) { engine->characterWalk(b, ToLab(step)); }
+void SceneLabPhysics::CharacterJump(int b) { engine->characterJump(b); }
+
+} // namespace hg
