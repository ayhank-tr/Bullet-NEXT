+// Bullet NEXT Lab - the Lab physics module of HARFANG (FL, CL.2).
+// Runs a Lab scene file on one Lab engine (legacy, next, nextf...) inside HARFANG. Several
+// SceneLabPhysics can run side by side in one program. The physics world keeps the scene's axes
+// (Z up); everything this class returns is in HARFANG's axes (Y up): x stays, y and z swap.
+#pragma once
+
+#include "engine/model_builder.h"
+#include "engine/node.h"
+#include "engine/render_pipeline.h"
+#include "foundation/color.h"
+#include "foundation/matrix4.h"
+#include "foundation/time.h"
+#include "foundation/vector3.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace bnl {
+class Engine;
+struct SceneDesc;
+} // namespace bnl
+
+namespace hg {
+
+class Scene;
+
+enum LabBodyKind { LBK_Static, LBK_Dynamic, LBK_Rigid, LBK_Sensor, LBK_Character, LBK_Soft };
+
+class SceneLabPhysics {
+public:
+	SceneLabPhysics();
+	~SceneLabPhysics();
+
+	/// Engines linked into this build ("legacy", "next", "nextf"...).
+	static std::vector<std::string> GetEngineNames();
+	/// Scene files listed by <dir>/index.json.
+	static std::vector<std::string> GetSceneNames(const std::string &dir);
+
+	/// Loads a Lab scene file and builds it on the named engine (threads: -1 = BN_THREADS variable).
+	bool LoadScene(const std::string &path, const std::string &engine, int threads = -1);
+	/// Loads a Lab scene file and plays a recording of it (.bnl, written by any Lab program).
+	bool LoadRecording(const std::string &path, const std::string &recording);
+	const std::string &GetError() const { return error; }
+	std::string GetEngineName() const;
+	std::string GetSceneName() const;
+
+	int GetFrameCount() const; // the scene's length in frames
+	int GetFrame() const;      // frames stepped so far
+	float GetTimeStep() const; // seconds per frame
+
+	/// One frame: the scene's scripted actions, then one fixed step.
+	void Step();
+	double GetLastStepMs() const;
+	/// Hashes as the harness prints them (16 hex digits).
+	std::string GetFrameHash() const;
+	std::string GetFinalHash() const;
+
+	int GetBodyCount() const;
+	LabBodyKind GetBodyKind(int body) const;
+	std::string GetBodyName(int body) const;
+	Mat4 GetBodyWorld(int body) const;
+	Vec3 GetBodyLinearVelocity(int body) const;
+	Vec3 GetBodyAngularVelocity(int body) const;
+
+	/// Drawing: a flat-shaded model of the body in its own space (not for soft bodies), and the
+	/// current triangles of a soft body in world space.
+	Model CreateBodyModel(int body, const bgfx::VertexLayout &layout) const;
+	void GetSoftBodyTriangles(int body, Vertices &vtx, const Color &color) const;
+	int GetWheelCount(int vehicle) const;
+	Mat4 GetWheelWorld(int vehicle, int wheel) const;
+	float GetWheelRadius(int vehicle, int wheel) const;
+	int GetVehicleCount() const;
+	/// Contact points as line pairs (point, point + normal * length) for drawing.
+	void GetContactLines(Vertices &vtx, float length, const Color &color) const;
+	int GetContactCount() const;
+
+	/// A game frame, as SceneUpdateSystems does for HARFANG's own physics: scene animations, one
+	/// physics frame, the nodes put on the bodies (node i follows body i), then world matrices.
+	void UpdateScene(Scene &scene, const std::vector<Node> &nodes, time_ns dt);
+	/// Puts the HARFANG nodes on the bodies. Only between Scene::ReadyWorldMatrices and
+	/// Scene::ComputeWorldMatrices (UpdateScene does that).
+	void SyncNodes(Scene &scene, const std::vector<Node> &nodes) const;
+
+	/// Game control
+	void SetLinearVelocity(int body, const Vec3 &v);
+	void SetAngularVelocity(int body, const Vec3 &w);
+	void AddForce(int body, const Vec3 &f);
+	void AddImpulse(int body, const Vec3 &j);
+	void AddImpulseAt(int body, const Vec3 &j, const Vec3 &world_pos);
+	void AddTorque(int body, const Vec3 &t);
+	void Teleport(int body, const Mat4 &world);
+	void Wake(int body);
+	bool RaycastFirstHit(const Vec3 &p0, const Vec3 &p1, int &body, Vec3 &P, Vec3 &N) const;
+	void VehicleControl(int vehicle, int wheel, float engine, float brake, float steer);
+	void CharacterWalk(int body, const Vec3 &step);
+	void CharacterJump(int body);
+
+private:
+	std::unique_ptr<bnl::SceneDesc> desc;
+	std::unique_ptr<bnl::Engine> engine;
+	std::string error;
+};
+
+} // namespace hg
