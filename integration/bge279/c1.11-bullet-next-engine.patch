+
+/** \file BN_PhysicsBackends.h
+ *  \ingroup physbullet
+ *
+ * Bullet NEXT (C1.11): the game engine's Bullet physics module is compiled twice.
+ *  - ge_phys_bullet_legacy: the 2.79b code against the frozen, renamed Bullet 2.84 (old files).
+ *  - ge_phys_bullet:        the same code against Bullet NEXT (scenes set to "Bullet NEXT").
+ * The converter picks one per scene through this header and never sees Bullet types.
+ */
+
+#ifndef __BN_PHYSICSBACKENDS_H__
+#define __BN_PHYSICSBACKENDS_H__
+
+struct Scene;
+class PHY_IPhysicsEnvironment;
+
+PHY_IPhysicsEnvironment *BN_CreateLegacyEnvironment(struct Scene *blenderscene, bool visualizePhysics);
+
+#ifdef WITH_BULLET_NEXT
+PHY_IPhysicsEnvironment *BN_CreateNextEnvironment(struct Scene *blenderscene, bool visualizePhysics);
+#endif
+
+/* Without WITH_BULLET_NEXT (engine built with the old extern/bullet2) every scene uses 2.79b's Bullet. */
+inline PHY_IPhysicsEnvironment *BN_CreatePhysicsEnvironment(struct Scene *blenderscene, bool visualizePhysics,
+                                                            bool useBulletNext)
+{
+#ifdef WITH_BULLET_NEXT
+	if (useBulletNext)
+		return BN_CreateNextEnvironment(blenderscene, visualizePhysics);
+#else
+	(void)useBulletNext;
+#endif
+	return BN_CreateLegacyEnvironment(blenderscene, visualizePhysics);
+}
+
+#endif  /* __BN_PHYSICSBACKENDS_H__ */
