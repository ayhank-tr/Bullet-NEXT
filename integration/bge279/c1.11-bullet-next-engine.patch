+/* Bullet NEXT (C1.5, C1.6, C1.8): the F1 collision features, per body, as the scene allows. */
+void CcdPhysicsEnvironment::BN_ConfigureBody(CcdPhysicsController *ctrl)
+{
+	btCollisionObject *obj = ctrl->GetCollisionObject();
+	if (!obj || !obj->getCollisionShape())
+		return;
+	if (!(m_bnFlag & GAME_BN_NO_HULL_CLIPPING))
+		btNextEnableHullClipping(obj->getCollisionShape());
+	if (!(m_bnFlag & GAME_BN_NO_ACTIVE_EDGES) && obj->isStaticOrKinematicObject())
+		btNextEnableActiveEdges(obj);  /* triangle meshes and heightfields only */
