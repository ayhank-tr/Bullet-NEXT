+		btSetTaskScheduler(scheduler);
+	}
+	int maxThreads = scheduler->getMaxNumThreads();
+	if (numThreads <= 0)
+		numThreads = maxThreads;
+	scheduler->setNumThreads(btMax(1, btMin(numThreads, maxThreads)));
+}
+#endif
