+/* One task scheduler for the whole game (Bullet's own threads, no OpenMP/TBB). Results are the same
+ * for any thread count, so the count of the last scene created simply wins. */
+static void BN_SetupThreads(int numThreads)
+{
+	static btITaskScheduler *scheduler = NULL;
+	if (!scheduler) {
+		scheduler = btCreateDefaultTaskScheduler();
+		if (!scheduler)
