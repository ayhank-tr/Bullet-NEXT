+/* Bullet NEXT (C1.11): solverType 1 = sequential impulse (2.79b), 2 = NNCG. Large islands use the
+ * threaded sequential impulse solver; small islands run one solver per thread. */
+void CcdPhysicsEnvironment::BN_CreateSolvers(int solverType)
+{
+	const int numSolvers = btMax(1, btGetTaskScheduler()->getNumThreads());
+	btConstraintSolver **solvers = new btConstraintSolver*[numSolvers];
+	for (int i = 0; i < numSolvers; ++i) {
+		if (solverType == 2)
+			solvers[i] = new btNNCGConstraintSolver();
+		else
+			solvers[i] = new btSequentialImpulseConstraintSolver();
+	}
+	m_bnSolverPool = new btConstraintSolverPoolMt(solvers, numSolvers);
+	delete[] solvers;
+	m_solver = (solverType == 2) ? NULL : new btSequentialImpulseConstraintSolverMt();
+}
+#endif
