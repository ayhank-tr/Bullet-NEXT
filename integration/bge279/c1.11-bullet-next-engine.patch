diff --git a/intern/rigidbody/CMakeLists.txt b/intern/rigidbody/CMakeLists.txt
index 5d84c2c..76934b4 100644
--- a/intern/rigidbody/CMakeLists.txt
+++ b/intern/rigidbody/CMakeLists.txt
@@ -35,4 +35,26 @@ set(SRC
 	RBI_api.h
 )
 
+if(WITH_BULLET_NEXT)
+	# Bullet NEXT (C1.11): Blender's rigid body world keeps 2.79b's Bullet exactly. Its source is
+	# renamed for Bullet NEXT's frozen legacy backend (btX -> btlX) and built against that.
+	find_package(Python3 REQUIRED COMPONENTS Interpreter)
+	set(_gen ${CMAKE_CURRENT_BINARY_DIR}/gen)
+	add_custom_command(
+		OUTPUT ${_gen}/rb_bullet_api.cpp
+		COMMAND ${Python3_EXECUTABLE} ${BN_RENAME_TOOL} files ${_gen} ${CMAKE_CURRENT_SOURCE_DIR}/rb_bullet_api.cpp
+		DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/rb_bullet_api.cpp ${BN_RENAME_TOOL}
+		COMMENT "Bullet NEXT: renaming the rigid body module for the legacy Bullet"
+	)
+	set(SRC
+		${_gen}/rb_bullet_api.cpp
+
+		RBI_api.h
+	)
+	set(INC_SYS
+		${BN_LEGACY_INCLUDE_DIR}
+	)
+	unset(_gen)
+endif()
+
 blender_add_lib(bf_intern_rigidbody "${SRC}" "${INC}" "${INC_SYS}")
