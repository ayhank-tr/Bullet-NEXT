@@ -1222,6 +1223,22 @@ else()
 	# set(BULLET_LIBRARIES "")
 endif()
 
+# Bullet NEXT replaces extern/bullet2. It carries two backends: Bullet NEXT (headers below; also used
+# by Blender's rigid body world) and the frozen, renamed Bullet 2.84 of Blender 2.79b, which runs the
+# game engine for old files and serves Bullet's C API (cloth collision, convex hull) to Blender.
+if(WITH_BULLET AND WITH_BULLET_NEXT AND NOT WITH_SYSTEM_BULLET)
+	if(NOT EXISTS "${CMAKE_SOURCE_DIR}/extern/bullet_next/CMakeLists.txt")
+		message(FATAL_ERROR "WITH_BULLET_NEXT: extern/bullet_next is missing, run: git submodule update --init extern/bullet_next")
+	endif()
+	set(BULLET_INCLUDE_DIRS
+		"${CMAKE_SOURCE_DIR}/extern/bullet_next/next"
+		"${CMAKE_SOURCE_DIR}/extern/bullet_next/blender_c_api"
+	)
+	add_definitions(-DWITH_BULLET_NEXT -DBT_THREADSAFE=1)
+else()
+	set(WITH_BULLET_NEXT OFF)
+endif()
+
 #-----------------------------------------------------------------------------
 # Configure Python.
 
