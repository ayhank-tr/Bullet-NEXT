+#ifdef WITH_PYTHON
+/* Bullet NEXT (C1.12): one contact point as seen by a collision callback's owner. Attribute names
+ * follow UPBGE's KX_CollisionContactPoint so scripts work in both. */
+static PyStructSequence_Field kx_contact_point_fields[] = {
+	{(char *)"localPointA", (char *)"Contact point on the owner, in the owner's space"},
+	{(char *)"localPointB", (char *)"Contact point on the collider, in the collider's space"},
+	{(char *)"worldPoint", (char *)"Contact point on the collider, in world space"},
+	{(char *)"normal", (char *)"Contact normal in world space, from the owner towards the collider"},
+	{(char *)"combinedFriction", (char *)"Friction of the two materials combined"},
+	{(char *)"combinedRollingFriction", (char *)"Rolling friction of the two materials combined"},
+	{(char *)"combinedRestitution", (char *)"Restitution (bounce) of the two materials combined"},
+	{(char *)"appliedImpulse", (char *)"Impulse the solver applied at this point in the last step"},
+	{NULL, NULL}
+};
+
+static PyStructSequence_Desc kx_contact_point_desc = {
+	(char *)"bge.types.KX_CollisionContactPoint",
+	(char *)"A contact point passed to 4-argument collision callbacks",
+	kx_contact_point_fields,
+	8
+};
+
+static PyTypeObject *kx_contact_point_type = NULL;
+
+static PyObject *KX_CollisionContactPoints(const PHY_CollData *colldata, bool first)
+{
+	const int num = colldata ? colldata->m_numContacts : 0;
+	PyObject *list = PyTuple_New(num);
+	if (num == 0)
+		return list;
+	if (!kx_contact_point_type)
+		kx_contact_point_type = PyStructSequence_NewType(&kx_contact_point_desc);
+	for (int i = 0; i < num; i++) {
+		const PHY_ContactPoint &cp = colldata->m_contacts[i];
+		PyObject *item = PyStructSequence_New(kx_contact_point_type);
+		PyStructSequence_SET_ITEM(item, 0, PyObjectFrom(first ? cp.m_localPointA : cp.m_localPointB));
+		PyStructSequence_SET_ITEM(item, 1, PyObjectFrom(first ? cp.m_localPointB : cp.m_localPointA));
+		PyStructSequence_SET_ITEM(item, 2, PyObjectFrom(cp.m_worldPoint));
+		PyStructSequence_SET_ITEM(item, 3, PyObjectFrom(first ? -cp.m_normal : cp.m_normal));
+		PyStructSequence_SET_ITEM(item, 4, PyFloat_FromDouble(cp.m_combinedFriction));
+		PyStructSequence_SET_ITEM(item, 5, PyFloat_FromDouble(cp.m_combinedRollingFriction));
+		PyStructSequence_SET_ITEM(item, 6, PyFloat_FromDouble(cp.m_combinedRestitution));
+		PyStructSequence_SET_ITEM(item, 7, PyFloat_FromDouble(cp.m_appliedImpulse));
+		PyTuple_SET_ITEM(list, i, item);
+	}
+	return list;
+}
+#endif  /* WITH_PYTHON */
+
