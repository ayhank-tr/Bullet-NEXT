+/* Bullet NEXT (C1.12): one contact point of a collision pair, in the pair's own order
+ * (A = object1, B = object2), so either object's view can be built from it. */
+typedef struct PHY_ContactPoint {
+	MT_Vector3 m_localPointA;          /* Point on object1, object1 space */
+	MT_Vector3 m_localPointB;          /* Point on object2, object2 space */
+	MT_Vector3 m_worldPoint;           /* Point on object2, world space */
+	MT_Vector3 m_normal;               /* World normal on object2, pointing towards object1 */
+	float m_combinedFriction;
+	float m_combinedRollingFriction;
+	float m_combinedRestitution;
+	float m_appliedImpulse;
+} PHY_ContactPoint;
+
+#define PHY_MAX_CONTACT_POINTS 4
+
 typedef struct PHY_CollData {
 	MT_Vector3 m_point1;               /* Point in object1 in world coordinates */
 	MT_Vector3 m_point2;               /* Point in object2 in world coordinates */
 	MT_Vector3 m_normal;               /* point2 - point1 */
+	/* Bullet NEXT (C1.12): every contact point of the pair, for 4-argument collision callbacks */
+	int m_numContacts;
+	PHY_ContactPoint m_contacts[PHY_MAX_CONTACT_POINTS];
 } PHY_CollData;
 
 
