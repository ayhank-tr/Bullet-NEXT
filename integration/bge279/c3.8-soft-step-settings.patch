+/* Bullet NEXT (F3c, C3.8): the Soft Step solver's settings; zero or less keeps a setting's default
+ * (substeps per second 540, contact stiffness an eighth of the substep rate, damping ratio 10,
+ * push-out 3 m/s). They apply to the solvers now in use and to any made later. */
+void		CcdPhysicsEnvironment::SetSoftStepSettings(float substepRate, float contactHertz, float contactDampingRatio, float pushSpeed)
+{
+#ifdef BN_NEXT_BACKEND
+	btSoftStepSettings s;
+	if (substepRate > 0.0f) s.m_substepRate = substepRate;
+	if (contactHertz > 0.0f) s.m_contactHertz = contactHertz;
+	if (contactDampingRatio > 0.0f) s.m_contactDampingRatio = contactDampingRatio;
+	if (pushSpeed > 0.0f) s.m_contactPushMaxVelocity = pushSpeed;
+	m_bnSoftStep = s;
+	for (int i = 0; i < m_bnSoftStepSolvers.size(); ++i)
+		m_bnSoftStepSolvers[i]->setSettings(s);
+#else
+	(void)substepRate; (void)contactHertz; (void)contactDampingRatio; (void)pushSpeed;
+#endif
+}
